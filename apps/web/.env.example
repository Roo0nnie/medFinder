# ==========================================================
# WEB APP ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development

# Public URLs — NEXT_PUBLIC_APP_URL must match how you open the app in the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Must be SAME ORIGIN as the web app so Better Auth session cookies are sent with fetch(..., { credentials: "include" }).
# Next.js rewrites (BACKEND_PROXY_URL below) forward /api/v1/* to Django.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1
#
# Django base URL (no trailing slash). Required whenever the browser cannot call Django directly
# (different host/port than NEXT_PUBLIC_APP_URL — including Vercel web + Render API).
BACKEND_PROXY_URL=http://localhost:8000
#
# Production example:
#   NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
#   NEXT_PUBLIC_API_BASE_URL=https://your-app.vercel.app/api
#   BACKEND_PROXY_URL=https://your-django.onrender.com
# On Render (Django), set CORS_ORIGINS to include NEXT_PUBLIC_APP_URL (browser still needs CORS for any direct calls).

# Better Auth (used by /api/auth route; server-side)
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_SECRET=change-me-min-32-chars-long-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8001,http://localhost:8000,http://10.10.0.5:8001
DATABASE_URL=postgres://postgres:password@localhost:5432/medFinder

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyDgp4QGZeRHQsocep5epoMYU4gvL_YV4cE
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyC9eax1KpAwZOT1AwH2S3tYkcBf16UoOpE
