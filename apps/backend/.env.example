# ==========================================================
# BACKEND API ENVIRONMENT VARIABLES (Django)
# ==========================================================

# Server
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Use 8000 if you see "You don't have permission to access that port" on Windows (also set NEXT_PUBLIC_API_BASE_URL in apps/web/.env)
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8001,http://localhost:8000

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/medFinder

# Optional: override DATABASE_URL with individual vars
# PGDATABASE=turbo_template
# PGUSER=postgres
# PGPASSWORD=password
# PGHOST=localhost
# PGPORT=5432

# ----------------------------------------------------------
# Render.com (production Docker / Web Service)
# ----------------------------------------------------------
# In Render: New Web Service → connect repo → Environment "Docker"
#   Root Directory: apps/backend   (monorepo; Dockerfile is in this folder)
#   Dockerfile Path: ./Dockerfile
# Render sets PORT automatically — do not hardcode it in the dashboard.
#
# Required env vars on Render:
#   SECRET_KEY              Strong random string (Render can "generate" a secret)
#   ALLOWED_HOSTS           Your service hostname, e.g. medfinder-api.onrender.com
#   DATABASE_URL            From Render Postgres: Internal or External URL (dj-database-url parses it)
#   CORS_ORIGINS            Comma-separated HTTPS origins of your Next app, e.g. https://your-app.vercel.app
#
# Recommended for HTTPS / admin / cookie flows:
#   CSRF_TRUSTED_ORIGINS    Same style as CORS, e.g. https://medfinder-api.onrender.com,https://your-app.vercel.app
#
# After deploy, point the web app at:
#   NEXT_PUBLIC_API_BASE_URL=https://<your-service>.onrender.com/api
#
# Cross-site cookies: Better Auth session cookies are scoped to the web app origin.
# For the Django API to see the same session on a different host (*.onrender.com vs *.vercel.app),
# you typically need a shared parent domain (custom domain + cookie domain) or token auth — plan accordingly.
