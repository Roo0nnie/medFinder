# ==========================================================
# BACKEND API ENVIRONMENT VARIABLES (Django)
# ==========================================================

# Server
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Use 8000 if you see "You don't have permission to access that port" on Windows.
# If you change this locally, also update NEXT_PUBLIC_API_BASE_URL in apps/web/.env.
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8001,http://localhost:8000

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/medFinder

# Optional: override DATABASE_URL with individual vars
# PGDATABASE=medfinder
# PGUSER=postgres
# PGPASSWORD=password
# PGHOST=localhost
# PGPORT=5432

# ----------------------------------------------------------
# Render.com (production Docker / Web Service)
# ----------------------------------------------------------
# The Django API must use apps/backend/Dockerfile. If Render logs show the
# repo-root Node image, `pnpm build`, or missing NEXT_PUBLIC_* variables, the
# service is using the wrong Dockerfile for the backend.
#
# Recommended automated path:
#   Use the repo-root render.yaml Blueprint. It scopes this service to
#   rootDir=apps/backend, dockerfilePath=./Dockerfile, and dockerContext=.
#
# Manual path for an existing Render Web Service:
#   Settings -> Build & Deploy
#     Root Directory:  apps/backend
#     Dockerfile Path: ./Dockerfile
#     Docker Context:  .
#
# Runtime: Docker. Render sets PORT, so do not set PORT in the dashboard.
#
# Required env vars on Render:
#   DEBUG                  false
#   SECRET_KEY             Strong generated production secret
#   ALLOWED_HOSTS          Your API hostname, e.g. medfinder-api.onrender.com
#   DATABASE_URL           Existing production database URL
#   CORS_ORIGINS           HTTPS origin of your Next app, e.g. https://your-app.vercel.app
#
# Recommended for HTTPS / admin / cookie flows:
#   CSRF_TRUSTED_ORIGINS   API + web origins, e.g.
#                          https://medfinder-api.onrender.com,https://your-app.vercel.app
#
# After deploy, point the web app at:
#   NEXT_PUBLIC_API_BASE_URL=https://<your-api-service>.onrender.com/api
#
# Cross-site cookies: Better Auth session cookies are scoped to the web app
# origin. For the Django API to see the same session on a different host, use
# a shared parent custom domain/cookie domain or token auth.
