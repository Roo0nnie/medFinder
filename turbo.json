{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build", "^lint", "^typecheck"],
			"outputs": [".cache/tsbuildinfo.json", "dist/**"],
			"cache": true
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": false
		},
		"start": {
			"dependsOn": ["^build", "build"],
			"cache": false,
			"persistent": true
		},
		"format": {
			"outputs": [".cache/.prettiercache"],
			"outputLogs": "new-only"
		},
		"lint": {
			"dependsOn": ["^topo", "^build"],
			"outputs": [".cache/.eslintcache"],
			"cache": true
		},
		"typecheck": {
			"dependsOn": ["^topo", "^build"],
			"outputs": [".cache/tsbuildinfo.json"],
			"cache": true
		},
		"test": {
			"dependsOn": ["^test"],
			"cache": true,
			"outputs": ["coverage/**"]
		},
		"test:e2e": {
			"cache": false,
			"persistent": false
		},
		"clean": {
			"cache": false
		},
		"push": {
			"cache": false,
			"interactive": true
		},
		"studio": {
			"cache": false,
			"persistent": true
		}
	},
	"globalEnv": [
		"NEXT_PUBLIC_APP_URL",
		"NEXT_PUBLIC_API_BASE_URL",
		"NEXT_PUBLIC_API_VERSION",
		"NEXT_PUBLIC_MAPBOX_TOKEN",
		"NEXT_PUBLIC_GOOGLE_MAPS_API_KEY",
		"BACKEND_PROXY_URL"
	],
	"globalPassThroughEnv": [
		"NODE_ENV",
		"CI",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_URL",
		"VERCEL_BRANCH_URL",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"npm_lifecycle_event",
		"DATABASE_URL",
		"BETTER_AUTH_BASE_PATH",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_TRUSTED_ORIGINS",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET"
	]
}
